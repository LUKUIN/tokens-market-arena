<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>TokensWatch</AssemblyName>
    <RootNamespace>TokensWatch</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Tokens 观众席 · 人类版（C# / WPF）</Product>
    <Description>TokensMarket 人类版观众席。只经 HTTP 与既有服务通信，含交易面板、老虎机、贷款自救；不启动、不修改引擎。</Description>
    <!-- 单文件发布时把原生库解包到临时目录，避免 WPF 无法从内存加载 D3D 依赖 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Huge Wave clip: the original hugewave.ogg lifted from PvZ's main.pak
         (sounds\hugewave.ogg, 111,507 B, 44.1 kHz stereo, 6.57 s), transcoded to PCM WAV
         so WPF can play it without an Ogg codec. Content + CopyToOutputDirectory keeps it
         out of the assembly resource stream on purpose. -->
    <Content Include="Assets\hugewave.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
