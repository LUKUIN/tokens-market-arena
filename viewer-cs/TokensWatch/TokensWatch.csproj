<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>TokensWatch</AssemblyName>
    <RootNamespace>TokensWatch</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Tokens Spectator (C# / WPF)</Product>
    <Description>Read-only spectator front end for TokensMarket. It polls the existing service over HTTP only and never starts or modifies the engine.</Description>
    <!-- Single-file publish unpacks native libraries to a temp directory so WPF can load its D3D dependencies -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Huge Wave clip: the original hugewave.ogg lifted from PvZ's main.pak
         (sounds\hugewave.ogg, 111,507 B, 44.1 kHz stereo, 6.57 s), transcoded to PCM WAV
         so WPF can play it without an Ogg codec. Content + CopyToOutputDirectory keeps it
         out of the assembly resource stream on purpose. -->
    <Content Include="Assets\hugewave.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
