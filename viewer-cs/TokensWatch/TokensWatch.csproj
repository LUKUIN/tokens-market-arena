<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>TokensWatch</AssemblyName>
    <RootNamespace>TokensWatch</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Tokens 观众席（C# / WPF）</Product>
    <Description>TokensMarket 的只读观众席前端。只经 HTTP 轮询既有服务，不启动、不修改引擎。</Description>
    <!-- 单文件发布时把原生库解包到临时目录，避免 WPF 无法从内存加载 D3D 依赖 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      一大波预警音效：从 PvZ 的 main.pak 里提的原版 hugewave.ogg
      （sounds\hugewave.ogg，111,507 B，44.1kHz / 立体声 / 6.57 秒），
      转成 PCM WAV 是为了绕开 WPF 播放 Ogg 需要额外解码器的问题
      —— SoundPlayer 只吃 WAV，带编解码依赖的 MediaPlayer 在干净机器上会静音。
      用 Content + CopyToOutputDirectory：不进程序集资源流，避免拖大单文件体积。
    -->
    <Content Include="Assets\hugewave.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
