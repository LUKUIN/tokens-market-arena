<Window x:Class="TokensWatch.Panels.LoanRescueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="资金告负 · 是否借款"
        Height="360" Width="560"
        MinHeight="320" MinWidth="520"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="资金告负" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource Bad}" />

        <TextBlock Grid.Row="1" x:Name="TxtCash" Text="" FontSize="14"
                   Foreground="{StaticResource Ink}" Margin="0,4,0,0" />

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="TxtLimit" Text="可借额度 —" FontSize="14"
                           Foreground="{StaticResource Ink}" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                           Foreground="{StaticResource Muted}"
                           Text="借款会补上现金、同时增加欠款，净值不变——它买的是继续下注的保证金。每借一笔：总目标 = 原目标 + 该笔金额 × 比例（1%~100%，随累计借款额上升，借越多比例越高，借完才定）。" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="剩余时间" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TxtRemain" Text="—" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource Bad}" Margin="10,0,0,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="借款金额" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="24,0,8,0" />
            <TextBox x:Name="TxtAmount" Width="150" FontSize="14" Height="30"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="TxtMsg" Text="" FontSize="13"
                   Foreground="{StaticResource Muted}" Margin="0,8,0,0"
                   TextWrapping="Wrap" MinHeight="20" />

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Button x:Name="BtnConfirm" Content="确认借款" Style="{StaticResource PrimaryButton}"
                    Padding="22,8" Click="OnConfirmClick" />
            <Button x:Name="BtnAbort" Content="否，终止游戏" Style="{StaticResource DangerButton}"
                    Padding="18,8" Margin="10,0,0,0" Click="OnAbortClick" />
        </StackPanel>
    </Grid>
</Window>
