<Window x:Class="TokensWatch.Panels.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity (all)"
        Height="500" Width="920"
        MinHeight="320" MinWidth="560"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <TextBlock Text="Activity" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                <StackPanel x:Name="TabPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="12">
                <StackPanel x:Name="LogStack" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
