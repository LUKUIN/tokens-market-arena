<Window x:Class="TokensWatch.Panels.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="规则 | Tokens 交易市场"
        Height="800" Width="760"
        MinHeight="520" MinWidth="620"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="规则" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource Ink}" />
            <TextBlock Text="规则以 GET /rules 的返回为准；本窗口只是它的可读排版。"
                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14">
            <TextBox x:Name="Body" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" FontSize="14" FontFamily="{StaticResource UiFont}"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" />
        </Border>

        <!-- 挑战任务：定档后由引擎提出，玩家在这里做一次决定（PvZ2 关卡目标） -->
        <Border x:Name="ChallengeCard" Grid.Row="2" Style="{StaticResource CardBorder}"
                Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="挑战任务" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="TxtChallengeNote" Style="{StaticResource Caption}"
                           Margin="0,4,0,8" TextWrapping="Wrap" />
                <StackPanel x:Name="ChallengeList" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnChallengeOn" Content="开启挑战任务"
                            Style="{StaticResource PrimaryButton}" Padding="18,7"
                            Margin="0,0,10,0" Click="OnChallengeAcceptClick" />
                    <Button x:Name="BtnChallengeOff" Content="不开启，正常玩"
                            Style="{StaticResource GhostButton}" Padding="18,7"
                            Click="OnChallengeDeclineClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="知道了" Style="{StaticResource PrimaryButton}"
                    Padding="26,8" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
