<Window x:Class="TokensWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TokensWatch.Controls"
        Title="Tokens Exchange · Spectator"
        Width="1920" Height="1080"
        MinWidth="1280" MinHeight="760"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             顶栏 56px：品牌 / 身份 / 模式徽章 / Status / 按钮，一行放完。
             原版拆成「红色标题栏 + 深蓝工具栏」两行，做了同一件事。
             ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource Card}" CornerRadius="8"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                Height="56" Padding="18,0" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOKENS" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <TextBlock Text=" EXCHANGE" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />

                    <Border Width="1" Height="20" Background="{StaticResource Line}"
                            Margin="16,0" VerticalAlignment="Center" />

                    <TextBlock x:Name="TxtTrader" Text="Guest" FontSize="16"
                               FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                               VerticalAlignment="Center" />

                    <Border x:Name="ChipMode" Background="#EAF4FF" CornerRadius="11"
                            Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtMode" Text="Random events ON" FontSize="13"
                                   Foreground="{StaticResource Accent}" />
                    </Border>

                    <!-- One chip per global event; they are not joined into a single label -->
                    <Border x:Name="ChipFr" Background="#F1F1F1" CornerRadius="11"
                            Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtFr" Text="Preferred Financing" FontSize="13"
                                   Foreground="{StaticResource Warn}" />
                    </Border>

                    <Border x:Name="ChipSlot" Background="#F1F1F1" CornerRadius="11"
                            Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtSlot" Text="Slot machine" FontSize="13"
                                   Foreground="{StaticResource Warn}" />
                    </Border>

                    <Border x:Name="ChipSpecial" Background="#F1F1F1" CornerRadius="11"
                            Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSpecial" Text="No global events" FontSize="13"
                                   Foreground="{StaticResource Muted}" />
                    </Border>
                </StackPanel>

                <!-- Status居中：1920 下这里是视觉重心，也是每秒都在变的一行 -->
                <TextBlock Grid.Column="1" x:Name="TxtRunState" Text="Waiting for service…"
                           FontSize="15" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="24,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="AI Actions" Style="{StaticResource GhostButton}"
                            Margin="0,0,6,0" Click="OnOpenScratchClick" />
                    <Button x:Name="BtnAssist" Content="Outside Mercy" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,0" Click="OnOpenAssistClick" />
                    <Button Content="Minimize" Style="{StaticResource GhostButton}"
                            Margin="0,0,6,0" Click="OnMinimizeClick" />
                    <Button Content="End Process" Style="{StaticResource DangerButton}"
                            Click="OnQuitClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             主体：左 1424 看盘 / 右 400 辅助
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ======== 左栏 ========  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 指标卡：1920 下宽度充裕，四格对称 -->
                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,5,0" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="Account Equity (Tokens)" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TxtEquity" Text="—" FontSize="34" FontWeight="Bold" TextOptions.TextFormattingMode="Ideal"
                                       Foreground="{StaticResource Good}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="5,0,5,0" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="Total P&amp;L" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TxtPnl" Text="—" FontSize="27" FontWeight="Bold" TextOptions.TextFormattingMode="Ideal"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="5,0,5,0" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="Margin Level" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TxtMargin" Text="—" FontSize="34" FontWeight="Bold" TextOptions.TextFormattingMode="Ideal"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="5,0,0,0" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="Target Progress" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TxtTargetPct" Text="—" FontSize="34" FontWeight="Bold" TextOptions.TextFormattingMode="Ideal"
                                       Foreground="{StaticResource Accent}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 资金 + Target统计合并成一条紧凑信息带（原版是两条各占一整行） -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtFunds" Text="—" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtStats" Text="—" FontSize="12"
                                   Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 权益曲线：主视觉 -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <Grid Height="420">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,0,4,6">
                            <TextBlock Text="Equity Curve (Tokens)" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtFastForward" Text="FF left —" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <controls:EquityChart x:Name="ChartEquity" Grid.Row="1" />
                    </Grid>
                </Border>

                <!-- Positions：空态自动塌缩 -->
                <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,0">
                            <TextBlock Text="Positions" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="BtnHoldMore" Content="More" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" Visibility="Collapsed"
                                    Click="OnOpenHoldClick" />
                        </Grid>

                        <StackPanel Grid.Row="1">
                            <UniformGrid x:Name="HoldHeader" Columns="8" Margin="0,8,0,6">
                                <TextBlock Text="Pair" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="Side" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="Lots" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="Leverage" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="Entry" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="Last" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="Margin" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="Unrealized P&amp;L" Style="{StaticResource TableHeader}" />
                            </UniformGrid>
                            <StackPanel x:Name="HoldRows" />
                            <TextBlock x:Name="TxtHoldEmpty" Text="No open positions" FontSize="14"
                                       Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" Margin="0,14,0,14" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quotes：7 品种一排，每格约 200px，不再 4+3 留空洞 -->
                <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Quotes" Style="{StaticResource SectionTitle}" Margin="4,0,0,10" />
                        <UniformGrid x:Name="PriceGrid" Columns="7" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======== 右栏 ========  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Status -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Status" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
</Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ledger"
                                       Style="{StaticResource Caption}" Margin="0,0,14,9" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAudit" Text="—"
                                       FontSize="15" Margin="0,0,0,9" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Black swan"
                                       Style="{StaticResource Caption}" Margin="0,0,14,9" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtGap" Text="—"
                                       FontSize="15" Margin="0,0,0,9" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Liquidity"
                                       Style="{StaticResource Caption}" Margin="0,0,14,9" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtLiq" Text="—"
                                       FontSize="15" Margin="0,0,0,9" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Fast-forward"
                                       Style="{StaticResource Caption}" Margin="0,0,14,9" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtFf" Text="—"
                                       FontSize="15" Margin="0,0,0,9" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Global events"
                                       Style="{StaticResource Caption}" Margin="0,0,14,9" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtSpecialState" Text="None"
                                       FontSize="14" Margin="0,0,0,9" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Peak"
                                       Style="{StaticResource Caption}" Margin="0,0,14,9" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtPeak" Text="—"
                                       FontSize="15" Margin="0,0,0,9" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Trough"
                                       Style="{StaticResource Caption}" Margin="0,0,14,9" />
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtTrough" Text="—"
                                       FontSize="15" Margin="0,0,0,9" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Drawdown / Sharpe"
                                       Style="{StaticResource Caption}" Margin="0,0,14,0" />
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtRisk" Text="—"
                                       FontSize="15" TextWrapping="Wrap" />
                        </Grid>

                        <!-- 时间进度 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Line}" Height="5" CornerRadius="2.5"
                                    VerticalAlignment="Center">
                                <Border x:Name="BarTime" HorizontalAlignment="Left" Width="0"
                                        Background="{StaticResource Accent}" CornerRadius="2.5" />
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="TxtTimeLeft" Text="Left --:--"
                                       Style="{StaticResource Caption}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Activity：整列Left高度，最新在上，可滚动 -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Activity" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <Button Content="More" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" Click="OnOpenLogClick" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LogFeed" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
