<Window x:Class="TokensWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TokensWatch.Controls"
        Title="Tokens 交易市场 · 观众席"
        Width="1920" Height="1080"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid x:Name="MainLayout" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Card}" CornerRadius="8"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                Padding="18,0" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="Auto" MinHeight="54" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOKENS" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <TextBlock Text=" 交易市场" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <Border x:Name="ChipMode" Background="#EAF4FF" CornerRadius="11"
                            Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtMode" Text="已开启随机事件" FontSize="13"
                                   Foreground="{StaticResource Accent}" />
                    </Border>

                    <!-- 每个全局事件一个独立胶囊，不拼成一条 -->
                    <Border x:Name="ChipFr" Background="#F1F1F1" CornerRadius="11"
                            Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtFr" Text="优惠融资" FontSize="13"
                                   Foreground="{StaticResource Warn}" />
                    </Border>

                    <Border x:Name="ChipSlot" Background="#F1F1F1" CornerRadius="11"
                            Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtSlot" Text="老虎机" FontSize="13"
                                   Foreground="{StaticResource Warn}" />
                    </Border>

                    <Border x:Name="ChipSpecial" Background="#F1F1F1" CornerRadius="11"
                            Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSpecial" Text="无全局事件" FontSize="13"
                                   Foreground="{StaticResource Muted}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="AI 行为" Style="{StaticResource GhostButton}"
                            Margin="0,0,6,0" Click="OnOpenScratchClick" />
                    <Button x:Name="BtnAssist" Content="外部的怜悯" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,0" Click="OnOpenAssistClick" />
                    <Button Content="最小化" Style="{StaticResource GhostButton}"
                            Margin="0,0,6,0" Click="OnMinimizeClick" />
                    <Button Content="结束进程" Style="{StaticResource DangerButton}"
                            Click="OnQuitClick" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="参赛者" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" x:Name="TxtTrader" Text="访客" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Column="1" x:Name="TxtRunState" Text="等待服务启动"
                               FontSize="15" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================
             主体：左 1424 看盘 / 右 400 辅助
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition x:Name="ColRight" Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ======== 左栏 ========  -->
            <Grid Grid.Column="0">
                <!-- 曲线行用 * ：窗口高度不够时让它先收缩，报价台必须留在视野里 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- 指标卡 -->
                    <RowDefinition Height="Auto" />  <!-- 状态条 -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />  <!-- 持仓明细 -->
                    <RowDefinition Height="Auto" />  <!-- 报价台 -->
                </Grid.RowDefinitions>

                <!-- 指标卡：1920 下宽度充裕，四格对称 -->
                <UniformGrid x:Name="MetricCards" Grid.Row="0" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,5,0" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="账户权益（Tokens）" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TxtEquity" Text="—" FontSize="34" FontWeight="Bold" TextOptions.TextFormattingMode="Ideal"
                                       Foreground="{StaticResource Good}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="5,0,5,0" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="累计盈亏" Style="{StaticResource Caption}" />
                            <!-- Viewbox(DownOnly)：1600 档卡片变窄时 "+131,840 (+13.18%)" 会被右边缘切掉，
                                 空间够就保持 27 号，不够才等比缩小。 -->
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <TextBlock x:Name="TxtPnl" Text="—" FontSize="27" FontWeight="Bold"
                                           TextOptions.TextFormattingMode="Ideal" />
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="5,0,5,0" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="保证金水平" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TxtMargin" Text="—" FontSize="34" FontWeight="Bold" TextOptions.TextFormattingMode="Ideal"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="5,0,0,0" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="目标进度" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TxtTargetPct" Text="—" FontSize="34" FontWeight="Bold" TextOptions.TextFormattingMode="Ideal"
                                       Foreground="{StaticResource Accent}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 资金 + 目标统计合并成一条紧凑信息带（原版是两条各占一整行） -->
                <Border x:Name="FundsCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtFunds" Text="—" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtStats" Text="—" FontSize="12"
                                   Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 权益曲线：主视觉 -->
                <Border x:Name="ChartCard" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,0,4,6">
                            <TextBlock Text="权益曲线（Tokens）" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtFastForward" Text="快进剩 —" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <controls:EquityChart x:Name="ChartEquity" Grid.Row="1" />
                    </Grid>
                </Border>

                <!-- 持仓明细：空态自动塌缩 -->
                <Border x:Name="HoldCard" Grid.Row="3" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,0">
                            <TextBlock Text="持仓明细" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="BtnHoldMore" Content="更多" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" Visibility="Collapsed"
                                    Click="OnOpenHoldClick" />
                        </Grid>

                        <StackPanel Grid.Row="1">
                            <UniformGrid x:Name="HoldHeader" Columns="8" Margin="0,8,0,6">
                                <TextBlock Text="交易对" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="方向" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="手数" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="杠杆" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="开仓价" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="最新价" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="保证金" Style="{StaticResource TableHeader}" />
                                <TextBlock Text="浮动盈亏" Style="{StaticResource TableHeader}" />
                            </UniformGrid>
                            <StackPanel x:Name="HoldRows" />
                            <TextBlock x:Name="TxtHoldEmpty" Text="当前没有持仓" FontSize="14"
                                       Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" Margin="0,14,0,14" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 报价台：7 品种一排，每格约 200px，不再 4+3 留空洞 -->
                <Border x:Name="QuoteCard" Grid.Row="4" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="报价台" Style="{StaticResource SectionTitle}" Margin="4,0,0,10" />
                        <UniformGrid x:Name="PriceGrid" Columns="7" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======== 右栏 ========  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ChallengeGap" Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ActivityGap" Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 运行状态 -->
                <Border x:Name="StatusCard" Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="运行状态" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
</Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="账本自检"
                                       Style="{StaticResource Caption}" Margin="0,0,14,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAudit" Text="—"
                                       FontSize="15" Margin="0,0,0,6" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="黑天鹅"
                                       Style="{StaticResource Caption}" Margin="0,0,14,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtGap" Text="—"
                                       FontSize="15" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="流动性"
                                       Style="{StaticResource Caption}" Margin="0,0,14,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtLiq" Text="—"
                                       FontSize="15" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="快进"
                                       Style="{StaticResource Caption}" Margin="0,0,14,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtFf" Text="—"
                                       FontSize="15" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="全局事件"
                                       Style="{StaticResource Caption}" Margin="0,0,14,6" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtSpecialState" Text="无"
                                       FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="峰值"
                                       Style="{StaticResource Caption}" Margin="0,0,14,6" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtPeak" Text="—"
                                       FontSize="15" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="谷值"
                                       Style="{StaticResource Caption}" Margin="0,0,14,6" />
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtTrough" Text="—"
                                       FontSize="15" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="回撤|夏普"
                                       Style="{StaticResource Caption}" Margin="0,0,14,6" />
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtRisk" Text="—"
                                       FontSize="15" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="一大波"
                                       Style="{StaticResource Caption}" Margin="0,0,14,0" />
                            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TxtHugeWave" Text="—"
                                       FontSize="15" TextWrapping="Wrap" />
                        </Grid>

                        <!-- 时间进度 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Line}" Height="5" CornerRadius="2.5"
                                    VerticalAlignment="Center">
                                <Border x:Name="BarTime" HorizontalAlignment="Left" Width="0"
                                        Background="{StaticResource Accent}" CornerRadius="2.5" />
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="TxtTimeLeft" Text="剩余 --:--"
                                       Style="{StaticResource Caption}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                   <!-- 挑战任务：难度定档后询问参赛者是否开启；开启则实时显示三条目标的达成状态。
                     PvZ2 的 Level Objectives 移植：√ 达成 / × 破功 / · 进行中。 -->
                <Border x:Name="ChallengeCard" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="挑战任务" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtChallengeCount" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="13" Foreground="#6B6B6B" />
                        </Grid>
                        <ScrollViewer x:Name="ChallengeScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChallengeList" />
                        </ScrollViewer>
                        <TextBlock x:Name="TxtChallengeHint" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Text="本局游戏参赛者未开启挑战任务" />
                    </StackPanel>
                </Border>

             <!-- 活动流：整列剩余高度，最新在上，可滚动 -->
                <Border x:Name="ActivityCard" Grid.Row="4" Style="{StaticResource CardBorder}" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="活动流" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <Button Content="更多" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" Click="OnOpenLogClick" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LogFeed" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>


        <!-- ============================================================
             一大波预警横幅 —— PvZ「A HUGE WAVE OF ZOMBIES IS APPROACHING」的移植。
             三条硬要求：① 出现在 GUI 正中间；② 红字黑阴影；③ 无底色（透明）。
             出现动画：等比收拢（1.55 → 1.0）340ms + 淡入（0 → 1）160ms。
             锚点在底边中心（RenderTransformOrigin 0.5,1）：底边钉住、字从上方压下来落定，
             这是按原始录像逐帧量的（原版 60fps 下 12 帧完成，底边 y 恒为 354）。
             是等比缩放，横向纵向同一比例，不会把字压扁。
             IsHitTestVisible=False：横幅只负责吓人，不能挡住下面的按钮。
             ============================================================ -->
        <Grid x:Name="HugeWaveLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid x:Name="HugeWaveBanner"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,1.0" Opacity="0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HugeWaveScale" ScaleX="1.55" ScaleY="1.55" />
                </Grid.RenderTransform>

                <!-- 黑描边：WPF 的 TextBlock 没有 Stroke，用零偏移大模糊的阴影向外扩一圈 -->
                <TextBlock x:Name="HugeWaveOutline"
                           FontFamily="Microsoft YaHei UI" FontWeight="Black" FontSize="64"
                           Foreground="Black" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="10" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- 红字本体 + 右下黑色实投影，做 PvZ 那种「厚字」观感 -->
                <TextBlock x:Name="HugeWaveText"
                           FontFamily="Microsoft YaHei UI" FontWeight="Black" FontSize="64"
                           Foreground="#E21A1A" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" ShadowDepth="7" Direction="315" BlurRadius="0" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
