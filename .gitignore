# 运行产物（每次开局都会变，不该进版本库）
data/
_agent/

# Python 缓存
__pycache__/
*.py[cod]
*.pyd
*.c
build/

# 成品包专用（开源版不需要，防止误提交）
manifest.json
startgame.pyc
python-*.exe
~$*

# 编辑器
.vscode/
.idea/
*.swp

# source guard vault (temporary, restored after each match)
_guard_vault/

# 运行日志（每次开局都会写，不该进版本库）
*.log

# 发布包不随源码进库：只作为 Release 附件（v1.2.12 起）
*.zip

# 本地脚本与过程产物（不进版本库）
_scratch/
