# Runtime output (changes every match, must not be versioned)
data/
_agent/

# Python cache
__pycache__/
*.py[cod]
*.pyd
*.c
build/

# Packaged build only (not needed by the open-source edition; prevents accidental commits)
manifest.json
startgame.pyc
python-*.exe
~$*

# Editors
.vscode/
.idea/
*.swp

# source guard vault (temporary, restored after each match)
_guard_vault/

# Run logs (written every match, must not be versioned)
*.log

# Release bundles stay out of the repo: they ship as release assets
*.zip

# Local scripts and scratch output
_scratch/

# C# spectator build output (tracked so a fresh clone runs out of the box: rebuild and commit after touching the viewer)
viewer-cs/**/obj/
viewer-cs/**/bin/Debug/
viewer-cs/**/bin/**/*.pdb
viewer-cs/**/bin/**/*.cache
viewer-cs/**/bin/**/wpftmp/
viewer-cs/**/obj/
