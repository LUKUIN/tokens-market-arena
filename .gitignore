# 运行产物（每次开局都会变，不该进版本库）
data/
_agent/

# Python 缓存
__pycache__/
*.py[cod]
*.pyd
*.c
build/

# 成品包专用（开源版不需要，防止误提交）
manifest.json
startgame.pyc
python-*.exe
~$*

# 编辑器
.vscode/
.idea/
*.swp

# source guard vault (temporary, restored after each match)
_guard_vault/

# 运行日志（每次开局都会写，不该进版本库）
*.log

# Release bundles stay out of the repo: they ship as release assets
*.zip

# Local scripts and scratch output
_scratch/
