# Git applies the last matching attribute rule, so the wildcard rule must come first.

# Default: auto-detect, LF everywhere
* text=auto eol=lf

# Exception: Windows scripts must use CRLF.
# A .bat saved with LF makes cmd join the lines into one, and the Chinese text becomes "'xxx' is not recognized as an internal or external command".
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
